{
  "uid": "enervision-overview",
  "title": "EnerVision - Vue d'ensemble infra",
  "tags": ["enervision", "infra"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 100, "title": "PostgreSQL / TimescaleDB", "type": "row", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    {
      "id": 1,
      "title": "Instance up",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_up", "legendFormat": "up" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Connexions actives",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_stat_database_numbackends", "legendFormat": "{{datname}}" }]
    },
    {
      "id": 3,
      "title": "Cache hit ratio",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_blks_hit[5m])) / (sum(rate(pg_stat_database_blks_hit[5m])) + sum(rate(pg_stat_database_blks_read[5m])))",
          "legendFormat": "hit ratio"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Transactions / s (commit vs rollback)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit[5m])", "legendFormat": "commit - {{datname}}" },
        { "expr": "rate(pg_stat_database_xact_rollback[5m])", "legendFormat": "rollback - {{datname}}" }
      ]
    },
    {
      "id": 5,
      "title": "Lignes lues / écrites par seconde",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(pg_stat_database_tup_fetched[5m])", "legendFormat": "fetched - {{datname}}" },
        { "expr": "rate(pg_stat_database_tup_inserted[5m])", "legendFormat": "inserted - {{datname}}" },
        { "expr": "rate(pg_stat_database_tup_updated[5m])", "legendFormat": "updated - {{datname}}" }
      ]
    },

    { "id": 101, "title": "Redis", "type": "row", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }, "panels": [] },
    {
      "id": 6,
      "title": "Instance up",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "redis_up", "legendFormat": "up" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Clients connectés",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "redis_connected_clients", "legendFormat": "clients" }]
    },
    {
      "id": 8,
      "title": "Mémoire utilisée",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "redis_memory_used_bytes", "legendFormat": "used" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 9,
      "title": "Commandes traitées / s",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(redis_commands_processed_total[5m])", "legendFormat": "commands/s" }]
    },
    {
      "id": 10,
      "title": "Keyspace hits vs misses",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(redis_keyspace_hits_total[5m])", "legendFormat": "hits/s" },
        { "expr": "rate(redis_keyspace_misses_total[5m])", "legendFormat": "misses/s" }
      ]
    },

    { "id": 102, "title": "MinIO", "type": "row", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }, "panels": [] },
    {
      "id": 11,
      "title": "Noeuds en ligne",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "minio_cluster_nodes_online_total", "legendFormat": "online" }]
    },
    {
      "id": 12,
      "title": "Espace utilisé vs capacité",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "minio_cluster_usage_total_bytes", "legendFormat": "used" },
        { "expr": "minio_cluster_capacity_usable_total_bytes", "legendFormat": "capacity" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 13,
      "title": "Espace libre",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "minio_cluster_capacity_usable_free_bytes", "legendFormat": "free" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 14,
      "title": "Requêtes S3 / s",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(minio_s3_requests_total[5m])) by (api)", "legendFormat": "{{api}}" }]
    },

    { "id": 103, "title": "Traefik", "type": "row", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 }, "panels": [] },
    {
      "id": 15,
      "title": "Requêtes / s par entrypoint",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(traefik_entrypoint_requests_total[5m])) by (entrypoint, code)", "legendFormat": "{{entrypoint}} - {{code}}" }
      ]
    },
    {
      "id": 16,
      "title": "Connexions ouvertes",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "traefik_open_connections", "legendFormat": "{{entrypoint}}" }]
    },
    {
      "id": 17,
      "title": "Latence p95 par service",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(traefik_service_request_duration_seconds_bucket[5m])) by (le, service))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 18,
      "title": "Taux d'erreurs 5xx par service",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traefik_service_requests_total{code=~\"5..\"}[5m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    }
  ]
}
