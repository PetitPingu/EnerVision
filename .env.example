# Traefik
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# PostgreSQL / TimescaleDB
POSTGRES_USER=enervision
POSTGRES_PASSWORD=changeme
POSTGRES_DB=enervision
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://enervision:changeme@localhost:5432/enervision

# MinIO
MINIO_ROOT_USER=enervision
MINIO_ROOT_PASSWORD=changeme123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Endpoint utilisé par les apps Python en local (hors Docker, où
# MINIO_ENDPOINT=minio:9000 est fourni directement par docker-compose.yml)
MINIO_ENDPOINT=localhost:9000

# Comma-separated list of buckets to create on startup
MINIO_BUCKETS=raw,processed,models,backups

# Bucket où le worker ETL dépose le JSON brut de chaque lecture
MINIO_RAW_BUCKET=raw

# Redis (Streams alert.detected, publié par le worker ETL sur lecture critical)
REDIS_PORT=6379

# API mock EnerVision (fournie par le formateur)
ENERVISION_API_SCHEME=https
ENERVISION_API_HOST=api-mock.charlieandre.fr
ENERVISION_API_PORT=
ENERVISION_API_USERNAME=projet_eadl
ENERVISION_API_PASSWORD=projet_eadl140926250926

# Timeout et résilience des appels à l'API mock
ENERVISION_REQUEST_TIMEOUT=5
ENERVISION_API_MAX_RETRIES=3
ENERVISION_API_BACKOFF_BASE=0.5

# Worker ETL
ETL_POLL_INTERVAL_SECONDS=60

# core_api : origines autorisées pour les appels CORS depuis le dashboard
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
