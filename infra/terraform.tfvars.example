# Copier ce fichier vers terraform.tfvars et adapter les valeurs.
#   cp terraform.tfvars.example terraform.tfvars   (Linux/macOS)
#   copy terraform.tfvars.example terraform.tfvars (Windows)
#
# terraform.tfvars est ignoré par git (secrets). Voir aussi le .env racine
# pour docker compose — les noms diffèrent, voir le tableau dans le README
# ou la doc infra.

# --- Accès local (outputs, dashboard build) ---
# host = "localhost"

# --- PostgreSQL / TimescaleDB (.env : POSTGRES_*) ---
db_user     = "enervision"
db_password = "CHANGEME"
db_name     = "enervision"
# postgres_port = 5432

# --- MinIO (.env : MINIO_*) ---
minio_root_user     = "enervision"
minio_root_password = "CHANGEME"
minio_buckets       = "raw,processed,models,backups"
# minio_raw_bucket    = "raw"
# minio_models_bucket = "models"
# minio_port          = 9000
# minio_console_port  = 9001

# --- API mock EnerVision (.env : ENERVISION_API_*) ---
# Utiliser l'hôte réel : les conteneurs Docker n'atteignent pas localhost.
enervision_api_scheme   = "https"
enervision_api_host     = "api-mock.charlieandre.fr"
enervision_api_port     = ""
enervision_api_username = "votre_identifiant"
enervision_api_password = "CHANGEME"

# --- Worker ETL ---
# etl_poll_interval_seconds = 60

# --- Traefik (.env : TRAEFIK_*) ---
# traefik_http_port      = 80
# traefik_dashboard_port = 8080
# docker_socket_path     = "/var/run/docker.sock"

# --- CORS core_api (.env : CORS_ORIGINS) ---
# Ajouter toute origine depuis laquelle le dashboard appelle l'API.
# cors_origins = "http://localhost:3000,http://dashboard.localhost,http://localhost"

# --- Dashboard Next.js (.env : NEXT_PUBLIC_API_BFF_URL) ---
# Accès direct (simple) : http://localhost:8000
# Via Traefik (port 80) : http://localhost — rebuild requis si modifié :
#   terraform apply -replace="terraform_data.build_dashboard"
dashboard_api_bff_url = "http://localhost:8000"

# --- Monitoring (.env : PROMETHEUS_PORT, GRAFANA_ADMIN_*) ---
# prometheus_port         = 9090
# grafana_admin_user     = "admin"
# grafana_admin_password = "changeme"

# --- Ports exposés (optionnel, défauts dans variables.tf) ---
# core_api_port       = 8000
# prediction_port     = 8001
# recommendation_port = 8002
# dashboard_port      = 3000
# mlflow_port         = 5000
# redis_port          = 6379

# --- Docker ---
# Windows (Docker Desktop) : npipe:////./pipe/dockerDesktopLinuxEngine
# Linux (serveur)          : unix:///var/run/docker.sock
# docker_host = "unix:///var/run/docker.sock"
#
# Docker Engine 29+ exige le provider kreuzwerker/docker >= 3.6.2 (voir main.tf).

# --- Images applicatives (GHCR) ---
# Dev local (terraform apply build les images) :
# build_images_locally = true
#
# CI / VM (pull depuis GHCR, voir docs/registry-ghcr.md) :
# build_images_locally  = false
# image_registry_prefix = "ghcr.io/petitpingu/enervision"
# image_tag             = "dev"          # ou sha-<commit>, pr-<numéro> pour tests
#
# Pull GHCR à distance (terraform apply depuis le poste, Docker sur la VM via SSH) :
# vm_host         = "adresse.vm.ecole"
# ssh_user        = "deploy"
# ghcr_username   = "votre_compte_github"
# ghcr_read_token = "ghp_..."            # read:packages — ne pas committer
