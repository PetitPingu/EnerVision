# Adresse du service Prediction (voir docs/seq_predict_call.md)
PREDICTION_URL=http://localhost:8002

# Timeout de l'appel au service Prediction (secondes)
RECOMMENDATION_REQUEST_TIMEOUT=5

# Origines autorisées pour les appels CORS depuis le dashboard (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DATABASE_URL vit dans packages/db-schema (partagé avec core_api, etl_worker).
