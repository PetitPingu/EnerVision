# Connexion PostgreSQL (table readings_curated pour l'entraînement)
DATABASE_URL=postgresql+psycopg://enervision:changeme@localhost:5432/enervision

# Port HTTP local (8000 dans Docker)
PREDICTION_PORT=8002

# Source des données d'entraînement : mock | json | postgres
TRAINING_DATA_SOURCE=postgres
# TRAINING_DATA_JSON_PATH=tests/test.json

# Stockage des modèles entraînés (minio pour l'instant)
MODEL_STORE=minio
MODEL_NAME=energy-consumption
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=enervision
MINIO_ROOT_PASSWORD=changeme123
MINIO_MODELS_BUCKET=models
