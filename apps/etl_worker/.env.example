# Adresse de l'API mock fournie par le formateur
ENERVISION_API_HOST=test
ENERVISION_API_PORT=1234

# Timeout et résilience des appels à l'API mock
ENERVISION_REQUEST_TIMEOUT=5
ENERVISION_API_MAX_RETRIES=3
ENERVISION_API_BACKOFF_BASE=0.5

# PostgreSQL / TimescaleDB
DATABASE_URL=postgresql://enervision:changeme@localhost:5432/enervision

# MinIO (bucket raw : JSON brut par lecture)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=enervision
MINIO_ROOT_PASSWORD=changeme123
MINIO_RAW_BUCKET=raw

# Redis (Streams alert.detected, sur lecture critical)
REDIS_URL=redis://localhost:6379/0

# Intervalle de polling (secondes)
ETL_POLL_INTERVAL_SECONDS=60
