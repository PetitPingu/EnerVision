# Adresse de l'API mock fournie par le formateur
ENERVISION_API_HOST=test
ENERVISION_API_PORT=1234

# Timeout des appels HTTP (secondes)
ENERVISION_REQUEST_TIMEOUT=5

# Origines autorisées pour les appels CORS depuis le dashboard (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
